#!/bin/bash
# reboot-guard: refuse accidental reboot/shutdown with systemd RefuseManualStart drop-ins.
# An accident guard, not a security boundary: `systemctl reboot --force` still works.
# https://github.com/pbuchan-rh/reboot-guard  (MIT)
#
# status exit: 0 guarded, 1 not guarded, 2 allow-once pending.
# Other commands exit: 0 ok, 1 refused, 2 bad usage, 3 not root.

set -u
VERSION=2.0.0
# Targets, plus the services they pull in: `systemctl start systemd-reboot.service` skips the target (found on RHEL 10).
# exit.target: `systemctl exit` powers off a VM/host (systemd 257, found on RHEL 10).
# Pulled in as a dependency of an allowed target, a guarded service still starts (RefuseManualStart = manual only).
UNITS="reboot.target poweroff.target halt.target kexec.target soft-reboot.target exit.target
 systemd-reboot.service systemd-poweroff.service systemd-halt.service systemd-kexec.service systemd-soft-reboot.service
 systemd-exit.service"
R=${REBOOT_GUARD_ROOT:-}; R=${R%/}    # test only (make check): install into a scratch root, no systemctl
GUARD_DIR=$R/etc/systemd/system        # persistent guard
IMAGE_DIR=$R/usr/lib/systemd/system    # RPM or image mode (bootc): guard in /usr/lib
ALLOW_DIR=$R/run/systemd/system        # allow-once, wiped at boot
HELPER=/usr/sbin/reboot-guard
GUARD_FILE=50-reboot-guard.conf
ALLOW_FILE=99-reboot-guard-allow.conf
TAG=reboot-guard
CAD=$R/etc/systemd/system/ctrl-alt-del.target           # Ctrl-Alt-Del is started by systemd itself,
CAD_BACKUP=$CAD.reboot-guard-orig                      # not "manually", so RefuseManualStart misses it: mask it
BURST_CONF=$R/etc/systemd/system.conf.d/50-reboot-guard.conf # 7x Ctrl-Alt-Del in 2 s = forced reboot: turn off
LEGACY=$R/etc/systemd/system/shutdown.target.requires/reboot-guard.service  # KB 1580343 "Option 2" guard

usage() { echo "usage: $TAG status|allow-once --reason T|cancel|install|uninstall" >&2; exit 2; }
show_help() {
    cat <<EOF
$TAG $VERSION: blocks accidental reboot/shutdown

  status                  0 guarded, 1 not, 2 allow-once pending
  allow-once --reason T   allow next reboot only
  cancel                  undo allow-once
  install | uninstall

Not a security control: \`systemctl reboot --force\` still works.
EOF
}
who_am() { echo "${SUDO_USER:-${USER:-$(id -un)}}"; }
log() { [ -n "$R" ] || logger -t "$TAG" -- "$*"; }
need_root() { [ -n "$R" ] || [ "$(id -u)" -eq 0 ] || { echo "$TAG: needs root" >&2; exit 3; }; }
sd() { [ -n "$R" ] || systemctl "$@"; }
reload() { sd daemon-reload; }
usr_guard() { [ -f "$IMAGE_DIR/reboot.target.d/$GUARD_FILE" ]; }
usr_source() {   # where the /usr/lib guard came from
    if [ -e /run/ostree-booted ]; then echo image
    elif rpm -qf "$IMAGE_DIR/reboot.target.d/$GUARD_FILE" >/dev/null 2>&1; then echo rpm
    else echo /usr/lib; fi
}

# install from a downloaded copy: put the helper in /usr/sbin (never over the RPM's).
self_copy() {
    local src dest=$R$HELPER
    src=$(readlink -f "$0" 2>/dev/null) && grep -qx "VERSION=$VERSION" "$src" 2>/dev/null || return 0
    [ "$src" = "$(readlink -f "$dest" 2>/dev/null)" ] && return 0
    [ -z "$R" ] && rpm -qf "$dest" >/dev/null 2>&1 && return 0
    cmp -s "$src" "$dest" && [ -x "$dest" ] && return 0
    mkdir -p "$(dirname "$dest")" 2>/dev/null
    install -m 0755 "$src" "$dest" || return 0
    [ -z "$R" ] && command -v restorecon >/dev/null && restorecon "$dest"
    echo "helper: $HELPER"
}

# Only units this systemd knows (soft-reboot exists on RHEL 10 only).
loaded_units() {
    local u
    for u in $UNITS; do
        systemctl show -p LoadState "$u" 2>/dev/null | grep -q '=loaded$' && echo "$u"
    done
}

write_dropins() {   # dir file value [comment]
    local u
    for u in $UNITS; do
        mkdir -p "$1/$u.d"
        printf '# %s: %s\n[Unit]\nRefuseManualStart=%s\n' "$TAG" "${4:-refuse manual start of $u}" "$3" > "$1/$u.d/$2"
    done
}

remove_dropins() {  # dir file
    local u
    for u in $UNITS; do
        rm -f "$1/$u.d/$2"
        rmdir "$1/$u.d" 2>/dev/null
    done
    return 0
}

# Ctrl-Alt-Del: mask the target (back up an existing admin symlink/file first) and disable the burst action.
cad_guard() {
    if [ "$(readlink "$CAD" 2>/dev/null)" != /dev/null ]; then
        { [ -e "$CAD" ] || [ -L "$CAD" ]; } && [ ! -e "$CAD_BACKUP" ] && [ ! -L "$CAD_BACKUP" ] && mv "$CAD" "$CAD_BACKUP"
        ln -sfn /dev/null "$CAD"
    fi
    # Supported on RHEL 7-10 (backported to 7/8, where systemctl show does not list it): detect via system.conf
    # (/etc on RHEL 7-9; RHEL 10 / systemd 257 ships it in /usr/lib only).
    if [ -n "$R" ] || grep -qs CtrlAltDelBurstAction /etc/systemd/system.conf /usr/lib/systemd/system.conf; then
        mkdir -p "$(dirname "$BURST_CONF")"
        printf '# %s: no forced reboot on repeated Ctrl-Alt-Del\n[Manager]\nCtrlAltDelBurstAction=none\n' "$TAG" > "$BURST_CONF"
        sd daemon-reexec
    fi
}
cad_unguard() {
    if [ "$(readlink "$CAD" 2>/dev/null)" = /dev/null ]; then
        rm -f "$CAD"
        { [ -e "$CAD_BACKUP" ] || [ -L "$CAD_BACKUP" ]; } && mv "$CAD_BACKUP" "$CAD"
    fi
    if [ -f "$BURST_CONF" ]; then rm -f "$BURST_CONF"; rmdir "$(dirname "$BURST_CONF")" 2>/dev/null; sd daemon-reexec; fi
    return 0
}

status() {
    local u guarded=0 open=0 allow=0
    for u in $(loaded_units); do
        if systemctl show -p RefuseManualStart "$u" | grep -q '=yes$'; then
            guarded=$((guarded + 1))
        else
            open=$((open + 1))
            [ -f "$ALLOW_DIR/$u.d/$ALLOW_FILE" ] && allow=$((allow + 1))
        fi
    done
    if [ -e "$LEGACY" ]; then echo "GUARDED by old KB 1580343 service (see README: Migrating)"; return 0; fi
    if [ "$open" -eq 0 ] && [ "$guarded" -gt 0 ]; then
        local s=GUARDED
        usr_guard && s="$s ($(usr_source))"
        [ "$(systemctl is-enabled ctrl-alt-del.target 2>/dev/null)" = masked ] || s="$s, Ctrl-Alt-Del NOT masked"
        echo "$s"; return 0
    elif [ "$allow" -gt 0 ]; then
        # allow-once writes "# reboot-guard: allow-once: REASON (by USER)" as line 1 of each allow file.
        local why; why=$(sed -n '1s/^# [^:]*: allow-once: //p' "$ALLOW_DIR/reboot.target.d/$ALLOW_FILE" 2>/dev/null)
        echo "ALLOW-ONCE${why:+: $why}"; return 2
    else
        echo "NOT GUARDED"; return 1
    fi
}

case "${1:-help}" in
    status)
        [ $# -eq 1 ] || usage
        status; exit $? ;;
    install)
        [ $# -eq 1 ] || usage
        need_root
        if ! usr_guard; then
            self_copy
            write_dropins "$GUARD_DIR" "$GUARD_FILE" yes; cad_guard; reload
            log "installed by $(who_am)"
        fi
        [ -n "$R" ] && exit 0
        status; exit 0 ;;
    uninstall)
        [ $# -eq 1 ] || usage
        need_root; remove_dropins "$GUARD_DIR" "$GUARD_FILE"; remove_dropins "$ALLOW_DIR" "$ALLOW_FILE"
        if usr_guard; then
            # The RPM / image owns the Ctrl-Alt-Del mask too: leave it.
            [ -f "$BURST_CONF" ] && rm -f "$BURST_CONF" && rmdir "$(dirname "$BURST_CONF")" 2>/dev/null; reload
            if [ "$(usr_source)" = image ]; then echo "$TAG: refused: guard is in the image (remove it in the Containerfile)" >&2
            else echo "$TAG: refused: guard is from the RPM (dnf remove reboot-guard)" >&2; fi
            exit 1
        fi
        cad_unguard; reload
        log "uninstalled by $(who_am)"; status; exit 0 ;;
    allow-once)
        reason=""
        case "${2:-}" in
            --reason) [ $# -eq 3 ] || usage; reason=$3 ;;
            --reason=*) [ $# -eq 2 ] || usage; reason=${2#--reason=} ;;
            *) [ $# -le 1 ] || usage ;;
        esac
        reason=$(printf '%s' "$reason" | tr '\n' ' ')
        [ -n "${reason// /}" ] || { echo "$TAG: allow-once needs --reason TEXT" >&2; exit 2; }
        need_root
        if [ -e "$LEGACY" ]; then echo "$TAG: refused: old KB 1580343 guard would still block (see README: Migrating)" >&2; exit 1; fi
        write_dropins "$ALLOW_DIR" "$ALLOW_FILE" no "allow-once: $reason (by $(who_am))"
        # soft-reboot (RHEL 10) keeps /run, so it would not consume the allow: remove it on the way down.
        printf '[Service]\nExecStartPre=-/bin/sh -c "rm -f %s/*.d/%s"\n' "$ALLOW_DIR" "$ALLOW_FILE" \
            >> "$ALLOW_DIR/systemd-soft-reboot.service.d/$ALLOW_FILE"
        reload
        log "allow-once by $(who_am): $reason"; status; exit 0 ;;
    cancel)
        [ $# -eq 1 ] || usage
        need_root
        if [ -n "$(find "$ALLOW_DIR" -maxdepth 2 -name "$ALLOW_FILE" 2>/dev/null | head -1)" ]; then
            remove_dropins "$ALLOW_DIR" "$ALLOW_FILE"; reload
            log "allow-once cancelled by $(who_am)"
        fi
        status; exit 0 ;;
    -h|--help|help)
        show_help ;;
    --version)
        echo "$TAG $VERSION" ;;
    *)
        usage ;;
esac
